{
  "name": "todo-assignment",
  "version": "1.0.0",
  "description": "SiteOps Checklist — 나 혼자 쓰는 웹사이트 운영 점검 Todo 앱 (로컬 SQLite)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:reset": "node -e \"require('fs').rmSync('db/siteops.db',{force:true})\"",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
