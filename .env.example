# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore에 들어 있어 GitHub에 올라가지 않습니다. 값은 화면(브라우저)에 절대 내려가지 않습니다.

# 저장소 선택: sqlite(기본값, 로그인 없음) 또는 turso(클라우드 SQLite + Google 로그인)
DB_DRIVER=sqlite

# --- Turso (DB_DRIVER=turso 일 때만 필요) ---
# turso.tech 대시보드 → 데이터베이스 → URL (libsql://...)
TURSO_DATABASE_URL=
# 같은 화면의 Create Token (데이터베이스 읽기·쓰기 토큰)
TURSO_AUTH_TOKEN=

# Google Cloud Console → Google 인증 플랫폼 → 클라이언트 (웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/auth/callback , https://<배포 주소>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인 쿠키 서명용 무작위 문자열 (32자 이상). 만들기: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PORT=3000

# 할 일 제목·메모 저장 시 암호화 키 (Turso 모드 필수, 32바이트 base64)
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 잃어버리면 저장된 할 일을 영영 읽을 수 없습니다. 비밀번호 관리자 등에 따로 보관하세요. 바꾸면 기존 데이터를 못 읽습니다.
DATA_ENCRYPTION_KEY=
